-- =========================================================
-- FOLLOW SYSTEM
-- =========================================================

local function getMyRoot()
	if not movementEnabled then return nil end
	local mover = getMover()
	if mover ~= localPlayer then return nil end
	local character = localPlayer.Character
	if not character then return nil end
	return character:FindFirstChild("HumanoidRootPart")
end

local function getTargetRoot()
	local target = getTarget()
	if not target or not target.Character then return nil end
	return target.Character:FindFirstChild("HumanoidRootPart")
end

local function calculatePosition(targetRoot)
	if orbitEnabled then
		local radians = math.rad(orbitAngle)
		local offset = Vector3.new(math.cos(radians) * orbitRadius, 0, math.sin(radians) * orbitRadius)
		return targetRoot.Position + offset
	end

	if not currentPosition then return nil end

	for _, position in ipairs(positions) do
		if position.name == currentPosition then
			return (targetRoot.CFrame * position.offset()).Position
		end
	end
	return nil
end

local function getFacingDirection(targetRoot)
	local forward = targetRoot.CFrame.LookVector
	local right = targetRoot.CFrame.RightVector

	if facingMode == "Vorne" then return forward
	elseif facingMode == "Hinten" then return -forward
	elseif facingMode == "Links" then return -right
	elseif facingMode == "Rechts" then return right
	elseif facingMode == "Links vorne" then return (forward - right).Unit
	elseif facingMode == "Rechts vorne" then return (forward + right).Unit end
	return forward
end

local function updateFollow(deltaTime)
	if not movementEnabled then return end

	local myRoot = getMyRoot()
	local targetRoot = getTargetRoot()

	if not myRoot or not targetRoot then return end

	if orbitEnabled then
		orbitAngle += orbitSpeed * deltaTime * orbitDirection
		if orbitAngle >= 360 then orbitAngle -= 360
		elseif orbitAngle <= -360 then orbitAngle += 360 end
	end

	local targetPosition = calculatePosition(targetRoot)
	if not targetPosition then return end

	local facingDirection = getFacingDirection(targetRoot)
	local targetCFrame

	if facingDirection.Magnitude > 0.001 then
		local horizontalDirection = Vector3.new(facingDirection.X, 0, facingDirection.Z)
		if horizontalDirection.Magnitude > 0.001 then
			horizontalDirection = horizontalDirection.Unit
			targetCFrame = CFrame.lookAt(targetPosition, targetPosition + horizontalDirection, Vector3.yAxis)
		else
			targetCFrame = CFrame.new(targetPosition)
		end
	else
		targetCFrame = CFrame.new(targetPosition)
	end

	-- MODI UNTERSCHEIDUNG
	if tapMovementMode == "Tween" then
		if activeTween then activeTween:Cancel() end
		local tweenInfo = TweenInfo.new(tweenSpeed, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		activeTween = TweenService:Create(myRoot, tweenInfo, {CFrame = targetCFrame})
		activeTween:Play()

	elseif tapMovementMode == "Teleport" then
		local currentTime = tick()
		if currentTime - lastTeleportTime >= teleportInterval then
			lastTeleportTime = currentTime
			myRoot.CFrame = targetCFrame
		end

	else
		-- Standard Lerp Bewegung
		local currentPositionVector = myRoot.Position
		local newPosition = currentPositionVector:Lerp(targetPosition, math.clamp(FOLLOW_SMOOTHNESS * deltaTime, 0, 1))

		if facingDirection.Magnitude > 0.001 then
			local horizontalDirection = Vector3.new(facingDirection.X, 0, facingDirection.Z)
			if horizontalDirection.Magnitude > 0.001 then
				horizontalDirection = horizontalDirection.Unit
				myRoot.CFrame = CFrame.lookAt(newPosition, newPosition + horizontalDirection, Vector3.yAxis)
			else
				myRoot.CFrame = CFrame.new(newPosition)
			end
		else
			myRoot.CFrame = CFrame.new(newPosition)
		end
	end

	if orbitEnabled then
		followStatus.Text = "Orbit aktiv | Radius: " .. tostring(orbitRadius) .. " | Speed: " .. tostring(orbitSpeed) .. "°/s"
	else
		followStatus.Text = "Pos: " .. tostring(currentPosition or "Keine") .. " | Modus: " .. tapMovementMode
	end
end

followConnection = RunService.RenderStepped:Connect(function(deltaTime)
	updateFollow(deltaTime)
end)

