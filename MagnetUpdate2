			"❌ Ziel: " .. getTargetName() .. " ist NICHT im Spiel"

		statusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
		statusDot.BackgroundColor3 = Color3.fromRGB(255, 80, 80)
	end

	if mover ~= localPlayer then
		modeInfo.Text =
			"⚠️ " ..
			getMoverName() ..
			" ist nicht dein eigener Character.\n" ..
			"Dieses LocalScript kann nur deinen eigenen Character bewegen."
	end
end

