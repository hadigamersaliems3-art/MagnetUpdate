UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if input.UserInputType ~= Enum.UserInputType.Keyboard then return end

	local keyCode = input.KeyCode

	if waitingForKey then
		if keyCode == Enum.KeyCode.Escape then
			local oldName = waitingForKey
			waitingForKey = nil
			updateKeyButton(oldName)
			return
		end

		local positionName = waitingForKey
		if isKeyAlreadyUsed(keyCode, positionName) then
			keyButtons[positionName].Text = positionName .. ": bereits benutzt"
			task.delay(1, function()
				if waitingForKey == positionName then
					keyButtons[positionName].Text = positionName .. ": [ Taste drücken ]"
				end
			end)
			return
		end

		keybinds[positionName] = keyCode
		waitingForKey = nil
		updateKeyButton(positionName)
		return
	end

	for positionName, assignedKey in pairs(keybinds) do
		if assignedKey == keyCode then
			setPosition(positionName)
			return
		end
	end

	if keyCode == Enum.KeyCode.M then
		if hub.Visible then
			hub.Visible = false
			openButton.Visible = true
		else
			hub.Visible = true
			openButton.Visible = false
		end
	end
end)

