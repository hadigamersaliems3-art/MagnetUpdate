	local target = getTarget()

	if target then
		statusLabel.Text =
			"✅ Ziel: " .. getTargetName() .. " | Beweger: " .. getMoverName()

		statusLabel.TextColor3 = Color3.fromRGB(80, 255, 80)
		statusDot.BackgroundColor3 = Color3.fromRGB(80, 255, 80)
	else
